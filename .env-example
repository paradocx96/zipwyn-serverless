# Copy to .env for local development:  cp .env.example .env
# Every value below is optional; these are the defaults used by `pnpm run dev`.

# Port of the local API (the Zipwyn frontend should call http://localhost:3001)
PORT=3001

# Origin used to build short links returned by the API.
# In production this is the redirect domain, e.g. https://zip.navindalc.app
BASE_URL=http://localhost:3001

# DynamoDB table name (must match Terraform's dynamodb_table_name in production)
URLS_TABLE=zipwyn-urls

# DynamoDB Local (started with `pnpm run db:start`).
# Leave empty ONLY if you intentionally want the dev server to use real AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-southeast-1

# Browser origins allowed to call the local API (comma-separated, or *)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: require an `x-api-key` header on create/list/stats, like production can do when `management_api_key` is
# set in Terraform.
# MANAGEMENT_API_KEY=change-me
